{
  "name": "sectioner",
  "version": "1.0.0",
  "private": true,
  "description": "Local annotation app: label regions on scanned pages and spans in texts (TEI), configured by JSON that people and agents can write.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo --hostname 127.0.0.1 --port 3040",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3040",
    "check": "next lint && tsc --noEmit && vitest run",
    "test": "vitest run",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sectioner": "tsx scripts/cli.ts"
  },
  "dependencies": {
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
